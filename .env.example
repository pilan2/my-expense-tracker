DIRECT_URL=""

# 품목 사진 업로드용. Supabase 대시보드에서 "item-images"라는 이름의 public 버킷을 미리
# 만들어둬야 한다. URL은 Project Settings > API의 Project URL,
# SERVICE_ROLE_KEY는 같은 페이지의 service_role 키(비공개로 취급할 것).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Cloud Console > 사용자 인증 정보 (OAuth 클라이언트)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# 로그인 허용할 단일 계정 (소유자 본인 이메일)
ALLOWED_EMAIL=""
