// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id        String  @id @default(cuid())
  genre     String // 장르
  character String // 캐릭터
  series    String? // 시리즈: 캐릭터가 등장하는 작품 버전 (예: 오리지널/리부트). 없는 캐릭터도 있어 선택
  itemType  String // 물품 종류 (대분류, 예: 아크릴/인형/피규어/기타)
  detail    String // 물품 세부사항 (구체적 품목명, 예: 키링/스탠드/고냥이)

  quantity    Int
  price       Decimal   @db.Decimal(12, 2) // 원 단위 저장 (입력 폼에서는 만원 단위 입력 후 환산)
  purchasedAt DateTime? // 구매일 (수기 입력 가능, 과거 날짜로 소급 등록도 허용). 모르면 비워둘 수 있고,
  // 이 경우 날짜 기반 통계(월별 추이 등)에서는 제외되고 단순 합계 통계에는 그대로 포함된다.

  hasOverseasShipping Boolean @default(false) // 이후 해외배송비 존재 여부
  shippingFee         Decimal @default(0) @db.Decimal(12, 2) // 배송비: 라인 전체 고정값(수량과 무관). 여러 품목을 한 배송으로 받으면 총 배송비를 품목 수로 나눠 배분
  maker               String? // 제작한 사람 (선택)
  organizer           String? // 공구 개최한 사람 (선택)

  isPhysical       Boolean   @default(false) // 현물 여부
  expectedShipDate DateTime? // 예상 발송일 (현물이 아닐 때만 사용)

  purchaseLink String? // 구매처 링크 (선택)
  memo         String? // 메모 (선택, 특이사항 등)
  imageUrl     String? // 사진 (선택). Supabase Storage에 올린 파일의 공개 URL을 저장.

  sales             Sale[]
  checklistEntries  EventChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id String @id @default(cuid())

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  quantitySold Int
  saleAmount   Decimal   @db.Decimal(12, 2)
  saleDate     DateTime? // 판매일. 모르면 비워둘 수 있고, purchasedAt과 마찬가지로 날짜 기반
  // 통계에서는 제외되고 단순 합계 통계에는 그대로 포함된다.

  createdAt DateTime @default(now())
}

// 품목 등록 폼에서 버튼으로 고를 수 있는 장르/캐릭터/시리즈/제작자/공구자 목록. Item의 해당
// 필드들은 여전히 문자열이라 이 목록에서 지워도 이미 등록된 품목은 그대로 남고, 앞으로
// 선택지에서만 빠진다.
model Genre {
  id         String      @id @default(cuid())
  name       String      @unique
  order      Int         @default(0) // 품목 등록/목록 화면에서 노출할 순서 (사용자가 직접 지정)
  characters Character[]
  makers     Maker[]
  organizers Organizer[]
  createdAt  DateTime    @default(now())
}

model Character {
  id      String @id @default(cuid())
  name    String
  order   Int    @default(0) // 같은 장르 안에서 노출할 순서 (사용자가 직접 지정)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  series Series[]

  createdAt DateTime @default(now())

  @@unique([genreId, name])
}

// 시리즈는 캐릭터에 종속(장르 > 캐릭터 > 시리즈).
model Series {
  id          String    @id @default(cuid())
  name        String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String

  createdAt DateTime @default(now())

  @@unique([characterId, name])
}

// 물품 종류(대분류)는 장르/캐릭터와 무관하게 전역으로 하나의 목록만 쓴다.
model ItemType {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0) // 노출할 순서 (사용자가 직접 지정)
  createdAt DateTime @default(now())
}

// 제작한 사람은 장르에만 종속.
model Maker {
  id      String @id @default(cuid())
  name    String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  createdAt DateTime @default(now())

  @@unique([genreId, name])
}

// 공구 개최한 사람도 장르에만 종속.
model Organizer {
  id      String @id @default(cuid())
  name    String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  createdAt DateTime @default(now())

  @@unique([genreId, name])
}

// 행사 당일 체크리스트: 부스별로 수령/구매할 것을 미리 적어두고, 당일 부스별로 묶어서 확인한다.
model Event {
  id      String @id @default(cuid())
  name    String // 행사 이름 (예: "코미케 104")
  date    DateTime? // 행사 날짜 (선택, 모르면 비워둘 수 있음)

  entries EventChecklistItem[]

  createdAt DateTime @default(now())
}

enum EventChecklistType {
  PICKUP // 수령: 이미 결제 완료, 현장에서 받기만 하면 됨
  PURCHASE // 구매: 현장에서 결제까지 해야 함
}

model EventChecklistItem {
  id       String             @id @default(cuid())
  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  booth    String // 부스명/번호
  label    String // 무엇을 수령/구매할지 간단한 설명 (품목 연결 시 자동 채움)
  type     EventChecklistType
  checked  Boolean            @default(false)
  price    Decimal            @default(0) @db.Decimal(12, 2) // 원 단위, 개당 가격 (품목 연결 시 자동 채움)
  quantity Int                @default(1)

  // 이미 등록된 품목과 연결(주로 수령 항목에서 상세 정보 확인용). 품목이 삭제돼도 체크리스트 항목은 남는다.
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId String?

  createdAt DateTime @default(now())
}
